{
	"name": "uppity",
	"version": "0.2.0",
	"private": true,
	"homepage": "https://github.com/NeonRook/uppity#readme",
	"bugs": {
		"url": "https://github.com/NeonRook/uppity/issues"
	},
	"license": "AGPL-3.0-only",
	"author": "NeonRook <hello@neonrook.com>",
	"repository": {
		"type": "git",
		"url": "https://github.com/NeonRook/uppity.git"
	},
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"build:strip-maps": "find build/server -name '*.map' -delete",
		"build:monitor": "bun build ./src/worker/monitor/index.ts --target=bun --outfile=build/worker-monitor.js",
		"build:notifier": "bun build ./src/worker/notifier/index.ts --target=bun --outfile=build/worker-notifier.js",
		"build:migrate": "bun build ./scripts/migrate.ts --target=bun --outfile=build/migrate.js",
		"build:workers": "bun run build:monitor && bun run build:notifier",
		"check:externals": "node scripts/check-externals.ts",
		"build:all": "bun run build && bun run build:strip-maps && bun run check:externals && bun run build:workers && bun run build:migrate",
		"preview": "vite preview",
		"worker:monitor": "bun run src/worker/monitor/index.ts",
		"worker:notifier": "bun run src/worker/notifier/index.ts",
		"worker:monitor:prod": "bun run build/worker-monitor.js",
		"worker:notifier:prod": "bun run build/worker-notifier.js",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && sv check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && sv check --tsconfig ./tsconfig.json --watch",
		"fmt": "oxfmt",
		"lint": "oxlint --type-aware --fix --fix-suggestions && eslint --fix .",
		"lint:ci": "oxfmt --check && oxlint --type-aware && eslint .",
		"test:unit": "vitest",
		"test": "bun run test:unit run && bun run test:e2e",
		"test:e2e": "playwright test",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:migrate:deploy": "bun run scripts/migrate.ts",
		"db:studio": "drizzle-kit studio",
		"auth:generate": "bun x auth@latest generate --output src/lib/server/db/auth-schema.ts --yes",
		"i18n:generate": "bun x @inlang/paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
		"changeset": "changeset",
		"changeset:version": "changeset version && bun install --lockfile-only",
		"changeset:tag": "changeset git-tag"
	},
	"dependencies": {
		"@better-auth/drizzle-adapter": "^1.7.1",
		"@fontsource-variable/ibm-plex-sans": "5.3.0",
		"@fontsource/ibm-plex-mono": "5.3.0",
		"@lucide/svelte": "^1.33.0",
		"@opentelemetry/api": "^1.9.1",
		"@polar-sh/better-auth": "^1.8.4",
		"@polar-sh/sdk": "^0.49.0",
		"better-auth": "^1.7.1",
		"clsx": "^2.1.1",
		"cron-parser": "^5.10.0",
		"drizzle-orm": "^0.45.2",
		"mode-watcher": "^1.1.0",
		"nanoid": "^6.0.1",
		"nodemailer": "^9.0.5",
		"pino": "^10.3.1",
		"postgres": "^3.4.9",
		"runed": "^0.37.1",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"valibot": "^1.4.2"
	},
	"devDependencies": {
		"@changesets/changelog-github": "^1.0.0",
		"@changesets/cli": "^3.0.1",
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^2.24.1",
		"@internationalized/date": "^3.12.3",
		"@libsql/client": "^0.17.4",
		"@playwright/test": "^1.62.1",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/bun": "^1.3.14",
		"@types/nodemailer": "^8.0.1",
		"@vitest/browser-playwright": "^4.1.11",
		"bits-ui": "^2.19.0",
		"drizzle-kit": "^0.31.10",
		"es-module-lexer": "^2.0.0",
		"eslint": "^10.8.1",
		"eslint-plugin-oxlint": "^1.79.0",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.11.0",
		"oxfmt": "^0.64.0",
		"oxlint": "^1.79.0",
		"oxlint-tsgolint": "^7.0.2001",
		"pino-pretty": "^13.1.3",
		"playwright": "^1.62.1",
		"sv": "^0.17.0",
		"svelte": "^5.56.9",
		"svelte-adapter-bun": "^1.0.1",
		"svelte-check": "^4.7.6",
		"svelte-sonner": "^1.2.1",
		"sveltekit-superforms": "^2.30.2",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.67.0",
		"vite": "^8.2.2",
		"vite-plugin-devtools-json": "^1.1.0",
		"vitest": "^4.1.11",
		"vitest-browser-svelte": "^3.0.0"
	},
	"overrides": {
		"brace-expansion": "^5.0.9",
		"defu": "^6.1.5",
		"flatted": "^3.4.2",
		"kysely": "^0.28.17",
		"postcss": "^8.5.23",
		"ws": "^8.21.0"
	},
	"engines": {
		"bun": ">=1.3.0"
	}
}
