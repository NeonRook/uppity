{
	"name": "uppity",
	"version": "0.9.0",
	"private": true,
	"homepage": "https://github.com/NeonRook/uppity#readme",
	"bugs": {
		"url": "https://github.com/NeonRook/uppity/issues"
	},
	"license": "AGPL-3.0-only",
	"author": "NeonRook <hello@neonrook.com>",
	"repository": {
		"type": "git",
		"url": "https://github.com/NeonRook/uppity.git"
	},
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"build:bundles": "vite build --config vite.workers.config.ts",
		"check:externals": "node scripts/check-externals.ts",
		"build:all": "pnpm build && pnpm build:bundles && pnpm check:externals",
		"preview": "vite preview",
		"worker:monitor": "pnpm build:bundles && node --env-file-if-exists=.env build/worker-monitor.js",
		"worker:notifier": "pnpm build:bundles && node --env-file-if-exists=.env build/worker-notifier.js",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && sv check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && sv check --tsconfig ./tsconfig.json --watch",
		"fmt": "oxfmt",
		"lint": "oxlint --type-aware --fix --fix-suggestions && eslint --fix .",
		"lint:ci": "oxfmt --check && oxlint --type-aware && eslint .",
		"test:unit": "vitest",
		"test": "pnpm test:unit run && pnpm test:e2e",
		"test:e2e": "playwright test",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:migrate:deploy": "node --env-file-if-exists=.env scripts/migrate.ts",
		"db:studio": "drizzle-kit studio",
		"auth:generate": "pnpm dlx auth@latest generate --output src/lib/server/db/auth-schema.ts --yes",
		"i18n:generate": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
		"changeset": "changeset",
		"changeset:version": "changeset version && pnpm install --lockfile-only",
		"changeset:tag": "changeset git-tag"
	},
	"dependencies": {
		"@better-auth/api-key": "^1.7.14",
		"@better-auth/drizzle-adapter": "^1.7.14",
		"@fontsource-variable/ibm-plex-sans": "5.3.0",
		"@fontsource/ibm-plex-mono": "5.3.0",
		"@lucide/svelte": "^1.65.0",
		"@opentelemetry/api": "^1.10.0",
		"@polar-sh/better-auth": "^2.1.3",
		"@polar-sh/sdk": "^1.0.2",
		"better-auth": "^1.7.14",
		"cron-parser": "^5.10.2",
		"drizzle-orm": "^0.45.4",
		"mode-watcher": "^1.1.0",
		"nanoid": "^6.0.2",
		"nodemailer": "^10.3.1",
		"pino": "^10.3.1",
		"postgres": "^4.0.0",
		"runed": "^0.38.0",
		"tailwind-variants": "^4.0.0",
		"undici": "^8.12.3",
		"valibot": "^1.5.0"
	},
	"devDependencies": {
		"@changesets/changelog-github": "^1.0.1",
		"@changesets/cli": "^3.0.3",
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^2.29.3",
		"@internationalized/date": "^3.12.4",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-node": "^6.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.6",
		"@types/nodemailer": "^8.0.2",
		"@vitest/browser-playwright": "^5.0.5",
		"bits-ui": "^2.20.2",
		"drizzle-kit": "^0.31.11",
		"es-module-lexer": "^3.0.4",
		"eslint": "^10.14.0",
		"eslint-plugin-oxlint": "^1.90.0",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.12.0",
		"oxfmt": "^0.75.0",
		"oxlint": "^1.90.0",
		"oxlint-tsgolint": "^7.0.2005",
		"pino-pretty": "^13.1.3",
		"playwright": "^1.64.1",
		"railway": "^3.16.0",
		"sv": "^1.1.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"svelte-sonner": "^1.2.2",
		"sveltekit-superforms": "^3.1.0",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.5",
		"vite-plugin-devtools-json": "^1.1.2",
		"vitest": "^5.0.5",
		"vitest-browser-svelte": "^3.1.0"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "^12.9.1",
			"onFail": "error"
		},
		"runtime": {
			"name": "node",
			"version": "^26.10.0",
			"onFail": "error"
		}
	},
	"engines": {
		"node": ">=26"
	}
}
