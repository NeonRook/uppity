{
	"name": "uppity",
	"version": "0.3.0",
	"private": true,
	"homepage": "https://github.com/NeonRook/uppity#readme",
	"bugs": {
		"url": "https://github.com/NeonRook/uppity/issues"
	},
	"license": "AGPL-3.0-only",
	"author": "NeonRook <hello@neonrook.com>",
	"repository": {
		"type": "git",
		"url": "https://github.com/NeonRook/uppity.git"
	},
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"build:strip-maps": "find .deno-deploy/server -name '*.map' -delete",
		"build:bundles": "vite build --config vite.workers.config.ts",
		"check:externals": "node scripts/check-externals.ts",
		"check:deno-entry": "tsc -p scripts/tsconfig.deno.json",
		"build:all": "aubr build && aubr build:strip-maps && aubr check:deno-entry && aubr build:bundles && aubr check:externals",
		"preview": "vite preview",
		"worker:monitor": "aubr build:bundles && node --env-file-if-exists=.env build/worker-monitor.js",
		"worker:notifier": "aubr build:bundles && node --env-file-if-exists=.env build/worker-notifier.js",
		"worker:monitor:prod": "node build/worker-monitor.js",
		"worker:notifier:prod": "node build/worker-notifier.js",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && sv check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && sv check --tsconfig ./tsconfig.json --watch",
		"fmt": "oxfmt",
		"lint": "oxlint --type-aware --fix --fix-suggestions && eslint --fix .",
		"lint:ci": "oxfmt --check && oxlint --type-aware && eslint .",
		"test:unit": "vitest",
		"test": "aubr test:unit run && aubr test:e2e",
		"test:e2e": "playwright test",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:migrate:deploy": "node --env-file-if-exists=.env scripts/migrate.ts",
		"db:studio": "drizzle-kit studio",
		"auth:generate": "aube dlx auth@latest generate --output src/lib/server/db/auth-schema.ts --yes",
		"i18n:generate": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
		"changeset": "changeset",
		"changeset:version": "changeset version && aube install --lockfile-only",
		"changeset:tag": "changeset git-tag"
	},
	"dependencies": {
		"@better-auth/drizzle-adapter": "^1.7.2",
		"@fontsource-variable/ibm-plex-sans": "5.3.0",
		"@fontsource/ibm-plex-mono": "5.3.0",
		"@lucide/svelte": "^1.38.0",
		"@opentelemetry/api": "^1.9.1",
		"@polar-sh/better-auth": "^1.8.4",
		"@polar-sh/sdk": "^0.49.0",
		"better-auth": "^1.7.2",
		"clsx": "^2.1.1",
		"cron-parser": "^5.10.0",
		"drizzle-orm": "^0.45.2",
		"mode-watcher": "^1.1.0",
		"nanoid": "^6.0.1",
		"nodemailer": "^9.1.0",
		"pino": "^10.3.1",
		"postgres": "^3.4.9",
		"runed": "^0.37.1",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"valibot": "^1.4.2"
	},
	"devDependencies": {
		"@changesets/changelog-github": "^1.0.0",
		"@changesets/cli": "^3.0.1",
		"@deno/svelte-adapter": "^0.2.1",
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^2.25.0",
		"@internationalized/date": "^3.12.3",
		"@libsql/client": "^0.17.4",
		"@playwright/test": "^1.62.1",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/deno": "^2.7.0",
		"@types/node": "^26.4.0",
		"@types/nodemailer": "^8.0.1",
		"@vitest/browser-playwright": "^4.1.11",
		"bits-ui": "^2.19.0",
		"drizzle-kit": "^0.31.10",
		"es-module-lexer": "^2.0.0",
		"eslint": "^10.9.1",
		"eslint-plugin-oxlint": "^1.80.0",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.11.0",
		"oxfmt": "^0.64.0",
		"oxlint": "^1.80.0",
		"oxlint-tsgolint": "^7.0.2001",
		"pino-pretty": "^13.1.3",
		"playwright": "^1.62.1",
		"railway": "^3.11.0",
		"sv": "^0.17.0",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"svelte-sonner": "^1.2.1",
		"sveltekit-superforms": "^2.30.2",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.68.0",
		"vite": "^8.2.2",
		"vite-plugin-devtools-json": "^1.1.0",
		"vitest": "^4.1.11",
		"vitest-browser-svelte": "^3.0.0"
	},
	"overrides": {
		"brace-expansion": "^5.0.9",
		"defu": "^6.1.5",
		"flatted": "^3.4.2",
		"kysely": "^0.28.17",
		"postcss": "^8.5.23",
		"ws": "^8.21.0"
	},
	"devEngines": {
		"packageManager": {
			"name": "aube",
			"version": "^2.2.0",
			"onFail": "error"
		},
		"runtime": {
			"name": "node",
			"version": "^26.8.0",
			"onFail": "error"
		}
	},
	"engines": {
		"node": ">=26"
	}
}
