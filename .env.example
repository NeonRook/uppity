# =============================================================================
# Uppity Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values.
# Required variables are marked with [Required], optional with [Optional].
# =============================================================================

# -----------------------------------------------------------------------------
# Self-hosted Mode [Optional]
# -----------------------------------------------------------------------------
# Set to "true" to run in self-hosted mode with all features unlocked.
# When enabled, subscription limits are bypassed and all features are available.
# SELF_HOSTED=true

# -----------------------------------------------------------------------------
# Polar Billing [Optional - required for SaaS mode]
# -----------------------------------------------------------------------------
# Polar access token from https://polar.sh/settings
# POLAR_ACCESS_TOKEN=polar_xxx

# Which Polar environment to talk to: sandbox or production (default: production).
# Sandbox and production are separate systems - a token, product ID or webhook
# secret from one is rejected by the other, so this must match the values above.
# POLAR_SERVER=sandbox

# Polar webhook secret for verifying webhook signatures
# Get this from Polar Organization Settings > Webhooks. Each webhook endpoint has
# its own signing secret; use the one for {BETTER_AUTH_URL}/api/auth/polar/webhooks
# POLAR_WEBHOOK_SECRET=whsec_xxx

# Polar product IDs (get these from Polar Dashboard > Products)
# These are different for sandbox vs production environments
# POLAR_PRODUCT_FREE=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# POLAR_PRODUCT_UPPITY_MONTHLY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# POLAR_PRODUCT_UPPITY_ANNUAL=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# POLAR_PRODUCT_DEDICATED_MONTHLY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# POLAR_PRODUCT_DEDICATED_ANNUAL=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# -----------------------------------------------------------------------------
# Database [Required]
# -----------------------------------------------------------------------------
# PostgreSQL connection string
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://uppity:password@localhost:5432/uppity

# -----------------------------------------------------------------------------
# Docker Compose Deployment [Optional]
# -----------------------------------------------------------------------------
# Used by docker-compose.yml to set the PostgreSQL password for the bundled
# `db` service and the DATABASE_URL passed to app/worker containers. Ignored
# outside of docker-compose deploys (set DATABASE_URL directly instead).
# Default: uppity
# DB_PASSWORD=uppity

# -----------------------------------------------------------------------------
# Authentication [Required]
# -----------------------------------------------------------------------------
# Better Auth secret key (minimum 32 characters)
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-key-here-min-32-chars

# Public URL of the application
# For development: http://localhost:5173
# For production behind a reverse proxy: the https:// URL users actually visit
BETTER_AUTH_URL=http://localhost:5173

# The public origin of the production server: the scheme and host users type,
# with no path. Form submissions from any other origin are rejected. Plain
# http:// works when nothing terminates TLS in front of the server.
# ORIGIN=https://status.example.com

# Instead of ORIGIN: the server assumes https:// and takes the host from the
# request's Host header, or from this header when a trusted proxy rewrites Host.
# Ignored when ORIGIN is set.
# HOST_HEADER=x-forwarded-host

# Trusted origins for CORS (comma-separated for multiple origins)
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:5173

# -----------------------------------------------------------------------------
# Server [Optional]
# -----------------------------------------------------------------------------
# Server port (default: 3000 in production, 5173 in development)
# PORT=3000

# Server host (default: 0.0.0.0 in production)
# HOST=0.0.0.0

# The header your reverse proxy sets to the client's address, e.g. x-real-ip.
# Sign-in rate limits and the audit log use it. The proxy must overwrite the
# header on every request, or clients can send their own value and dodge rate
# limits. Leave unset when nothing sits in front.
# CLIENT_IP_HEADER=x-real-ip

# -----------------------------------------------------------------------------
# Logging [Optional]
# -----------------------------------------------------------------------------
# Pino log level: trace, debug, info, warn, error, fatal, silent
# Default: info
# LOG_LEVEL=info

# Service name attached to every log line (useful when running app + workers
# behind the same log aggregator).
# Default: uppity
# SERVICE_NAME=uppity

# -----------------------------------------------------------------------------
# Email Notifications [Optional]
# -----------------------------------------------------------------------------
# SMTP server for password reset mail (web server) and email notifications
# (notifier worker). Both processes need these.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user
# SMTP_PASSWORD=password
# SMTP_FROM=noreply@example.com

# Sender address used when SMTP_FROM is unset
# UPPITY_EMAIL_FROM=Uppity <noreply@uppity.cloud>

# Separate SMTP server for status page subscriber mail and team invitations.
# Both go to addresses typed in by someone else, so a separate account keeps their
# bounces from suspending the one that sends alerts. Unset, this mail uses the SMTP
# server above. SUBSCRIBER_SMTP_FROM falls back to SMTP_FROM.
# SUBSCRIBER_SMTP_HOST=smtp.example.com
# SUBSCRIBER_SMTP_PORT=587
# SUBSCRIBER_SMTP_USER=user
# SUBSCRIBER_SMTP_PASSWORD=password
# SUBSCRIBER_SMTP_FROM=status@status.example.com

# Signing secret of a Resend webhook sending email.bounced and email.complained to
# /api/webhooks/resend. With it set, addresses that hard-bounce or complain stop
# getting subscriber mail, and organizations whose confirmations and invitations
# draw too many of them can't email new addresses until an admin clears them.
# Unset, the endpoint refuses every request. Set it on the web server.
# RESEND_WEBHOOK_SECRET=whsec_xxx

# -----------------------------------------------------------------------------
# Operator Alerts [Optional]
# -----------------------------------------------------------------------------
# Tells you when monitors stop being checked on this instance: checks are overdue,
# monitors are dead-lettered, or the database cannot be read. These go to you, not
# to your customers' notification channels. Set the variables on the notifier
# worker, which raises the alerts, and on the web server, which raises the mail
# ceiling and organization block alerts. With neither destination set, nothing is sent.
# Email uses the SMTP server above. Discord does not depend on that server, so
# setting both means one failure cannot silence the alert.
# UPPITY_OPS_ALERT_EMAIL=ops@example.com
# UPPITY_OPS_ALERT_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/000/xxx

# Hours before the same alert repeats while its cause lasts
# UPPITY_OPS_ALERT_COOLDOWN_HOURS=6

# -----------------------------------------------------------------------------
# Monitor Defaults [Optional]
# -----------------------------------------------------------------------------
# Default timeout for monitor checks (seconds)
# UPPITY_DEFAULT_TIMEOUT_SECONDS=30

# Default interval between checks (seconds)
# UPPITY_DEFAULT_INTERVAL_SECONDS=60

# Default number of retries before marking as down
# UPPITY_DEFAULT_RETRIES=0

# Default number of consecutive failures before alerting
# UPPITY_DEFAULT_ALERT_AFTER_FAILURES=1

# Default grace period for push monitors (seconds)
# UPPITY_DEFAULT_PUSH_GRACE_PERIOD_SECONDS=60

# Default SSL expiry warning threshold (days)
# UPPITY_DEFAULT_SSL_EXPIRY_THRESHOLD_DAYS=14

# Response time threshold for degraded status (milliseconds)
# UPPITY_DEGRADED_RESPONSE_TIME_MS=5000

# Cooldown between repeat SSL-expiry warning notifications for the same monitor (hours)
# UPPITY_SSL_WARNING_COOLDOWN_HOURS=24

# Delay between retries (milliseconds)
# UPPITY_RETRY_DELAY_MS=1000

# Let HTTP and TCP checks, and Slack, Discord and webhook notifications, reach
# private, loopback and link-local addresses, such as services on the same network
# as this instance. Off by default. Leave it off where users you do not trust
# create monitors: on, a monitor can reach the instance itself and its cloud
# metadata service.
# UPPITY_ALLOW_PRIVATE_TARGETS=true

# A PEM file of extra CA certificates to trust, such as a private CA for internal
# monitors. Read by Node at startup; no permission grant needed.
# NODE_EXTRA_CA_CERTS=/etc/ssl/private-ca.pem

# -----------------------------------------------------------------------------
# Status Page [Optional]
# -----------------------------------------------------------------------------
# Number of days of history to show on status pages
# UPPITY_STATUS_PAGE_HISTORY_DAYS=90

# Confirmation emails one status page may send to new subscribers in 24 hours:
# the base, or the percentage of its confirmed subscribers when that is more,
# never above the max
# UPPITY_SUBSCRIBER_CONFIRMATIONS_BASE=50
# UPPITY_SUBSCRIBER_CONFIRMATIONS_PERCENT=25
# UPPITY_SUBSCRIBER_CONFIRMATIONS_MAX=300

# Unanswered emails one organization may have sent in the past week: confirmations
# to email channel addresses and team invitations together. Each confirmation or
# accepted invitation frees its slot.
# UPPITY_CHANNEL_PENDING_CONFIRMATIONS=5

# Days a hard-bounced or complaining subscriber is kept before deletion. The address
# stays suppressed afterwards, until an admin lifts it under Admin > Suppressed addresses.
# UPPITY_SUPPRESSED_SUBSCRIBER_RETENTION_DAYS=90

# Emails to new addresses (channel confirmations, subscriber confirmations and
# invitations) the whole instance may send in 24 hours. Status page subscriptions may
# use half of it. 0 turns the ceiling off.
# Defaults to 1000, or 0 with SELF_HOSTED=true.
# UPPITY_UNSOLICITED_MAIL_DAILY_CEILING=1000

# An organization can't email new addresses once its failures in the window reach
# both the minimum count and the rate of its sends. Addresses visitors type into a
# status page don't count against it. Needs RESEND_WEBHOOK_SECRET.
# UPPITY_MAIL_REPUTATION_WINDOW_DAYS=30
# UPPITY_MAIL_BOUNCE_MIN=10
# UPPITY_MAIL_BOUNCE_PERCENT=7
# UPPITY_MAIL_COMPLAINT_MIN=3
# UPPITY_MAIL_COMPLAINT_PER_MILLE=3

# Set to "true" on the web server and the notifier to make status page email
# subscriptions something an admin turns on per organization. Unset, every organization
# has them. For the hosted service. A self-hosted instance leaves it unset.
# UPPITY_GATE_SUBSCRIBER_EMAIL=true

# Slug of a public status page to feature on the landing page. Hosted-instance
# only: the surrounding copy states that Uppity is monitoring itself. Leave
# unset to omit the section — a self-hosted instance should.
# UPPITY_LANDING_STATUS_SLUG=uppity

# -----------------------------------------------------------------------------
# Worker Scheduler [Optional]
# -----------------------------------------------------------------------------
# Minimum allowed monitor interval (seconds)
# UPPITY_MIN_INTERVAL_SECONDS=30

# Maximum allowed monitor interval (seconds, default: 24 hours)
# UPPITY_MAX_INTERVAL_SECONDS=86400

# Number of checks one monitor worker runs at once
# UPPITY_WORKER_BATCH_SIZE=10

# Initial backoff when no work found (milliseconds)
# UPPITY_WORKER_BACKOFF_INITIAL_MS=100

# Maximum backoff when no work found (milliseconds)
# UPPITY_WORKER_BACKOFF_MAX_MS=5000

# Consecutive checker failures before a monitor is dead-lettered. A dead-lettered
# monitor shows as not checked, notifies its channels, logs an error with
# event_type "monitor_dead_lettered", and keeps retrying at the maximum backoff.
# UPPITY_CHECK_MAX_RETRIES=3

# Initial backoff after check failure (milliseconds)
# UPPITY_CHECK_BACKOFF_INITIAL_MS=5000

# Maximum backoff after check failure (milliseconds, default: 5 minutes)
# UPPITY_CHECK_BACKOFF_MAX_MS=300000

# -----------------------------------------------------------------------------
# Background Jobs [Optional]
# -----------------------------------------------------------------------------
# Cron schedules for periodic worker housekeeping. Values are standard 5-field
# cron expressions evaluated in the worker process's local timezone.

# Aggregate the previous day's check data into monitor_daily_stats rows.
# UPPITY_CRON_DAILY_STATS=0 1 * * *

# Recalculate rolling 24-hour uptime and response time aggregates.
# UPPITY_CRON_ROLLING_STATS=*/5 * * * *

# Delete individual check records older than UPPITY_CHECK_RETENTION_DAYS.
# UPPITY_CRON_CLEANUP=0 2 * * *

# Days to keep individual check records before the cleanup cron deletes them.
# UPPITY_CHECK_RETENTION_DAYS=30

# Advance maintenance window status transitions (scheduled → in_progress → completed).
# UPPITY_CRON_MAINTENANCE_WINDOW_TRANSITIONS=* * * * *

# -----------------------------------------------------------------------------
# Session & Organization [Optional]
# -----------------------------------------------------------------------------
# Session expiration time (seconds, default: 30 days)
# UPPITY_SESSION_EXPIRES_IN_SECONDS=2592000

# Session update age (seconds, default: 1 day)
# UPPITY_SESSION_UPDATE_AGE_SECONDS=86400

# Maximum members per organization
# UPPITY_ORGANIZATION_MEMBERSHIP_LIMIT=100

# Maximum organizations per user
# UPPITY_ORGANIZATION_LIMIT_PER_USER=5

# Requests per minute per API key on self-hosted and Dedicated instances.
# Hosted Free and Uppity plans use their own fixed limits.
# UPPITY_API_REQUESTS_PER_MINUTE=600
