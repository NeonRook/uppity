{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["oxc", "node", "typescript", "unicorn", "import", "promise", "vitest"],
	"categories": {
		"correctness": "error",
		"perf": "error",
		"suspicious": "error"
	},
	"env": {
		"builtin": true,
		"browser": true,
		"node": true,
		"svelte": true
	},
	"ignorePatterns": ["drizzle"],
	"rules": {
		"@typescript-eslint/no-unsafe-type-assertion": "off",
		"no-await-in-loop": "off",
		"unicorn/no-empty-file": "off",
		"promise/no-multiple-resolved": "off",
		"@typescript-eslint/ban-ts-comment": "error",
		"@typescript-eslint/no-empty-object-type": "error",
		"@typescript-eslint/no-explicit-any": "error",
		"@typescript-eslint/no-namespace": "error",
		"@typescript-eslint/no-require-imports": "error",
		"@typescript-eslint/no-unsafe-function-type": "error",
		"import/first": "error",
		"import/no-amd": "error",
		"import/no-cycle": "error",
		"import/no-duplicates": "error",
		"import/no-dynamic-require": "error",
		"import/no-mutable-exports": "error",
		"import/no-named-default": "error",
		"import/no-unassigned-import": ["error", { "allow": ["**/*.css", "@testing-library/**"] }],
		"oxc/bad-array-method-on-arguments": "warn",
		"oxc/bad-char-at-comparison": "warn",
		"oxc/bad-comparison-sequence": "warn",
		"oxc/bad-min-max-func": "warn",
		"oxc/bad-object-literal-comparison": "warn",
		"oxc/bad-replace-all-arg": "warn",
		"oxc/const-comparisons": "warn",
		"oxc/double-comparisons": "warn",
		"oxc/erasing-op": "warn",
		"oxc/missing-throw": "warn",
		"oxc/number-arg-out-of-range": "warn",
		"oxc/no-barrel-file": "warn",
		"oxc/no-const-enum": "warn",
		"oxc/only-used-in-recursion": "warn",
		"oxc/uninvoked-array-callback": "warn",
		"array-callback-return": "error",
		"default-case-last": "error",
		"default-param-last": "error",
		"eqeqeq": ["error", "smart"],
		"func-names": ["error", "as-needed"],
		"max-depth": ["error", { "max": 4 }],
		"max-nested-callbacks": "error",
		"no-alert": "error",
		"no-array-constructor": "error",
		"no-case-declarations": "error",
		"no-constructor-return": "error",
		"no-else-return": "error",
		"no-empty": "error",
		"no-extra-label": "error",
		"no-fallthrough": "error",
		"no-inner-declarations": "error",
		"no-label-var": "error",
		"no-labels": "error",
		"no-lone-blocks": "error",
		"no-lonely-if": "error",
		"no-multi-assign": "error",
		"no-multi-str": "error",
		"no-negated-condition": "error",
		"no-nested-ternary": "error",
		"no-new-func": "error",
		"no-new-wrappers": "error",
		"no-object-constructor": "error",
		"no-param-reassign": "error",
		"no-prototype-builtins": "error",
		"no-redeclare": "error",
		"no-regex-spaces": "error",
		"no-restricted-globals": [
			"error",
			{ "name": "isFinite", "message": "Use Number.isFinite instead" },
			{ "name": "isNaN", "message": "Use Number.isNaN instead" }
		],
		"no-script-url": "error",
		"no-self-compare": "error",
		"no-template-curly-in-string": "error",
		"no-throw-literal": "error",
		"no-unused-vars": [
			"error",
			{
				"args": "all",
				"argsIgnorePattern": "^_",
				"caughtErrors": "all",
				"caughtErrorsIgnorePattern": "^_",
				"destructuredArrayIgnorePattern": "^_",
				"ignoreRestSiblings": true,
				"varsIgnorePattern": "^_"
			}
		],
		"no-useless-computed-key": "error",
		"no-void": ["error", { "allowAsStatement": true }],
		"operator-assignment": "error",
		"prefer-destructuring": "error",
		"prefer-numeric-literals": "error",
		"prefer-object-spread": "error",
		"prefer-template": "error",
		"radix": "error",
		"symbol-description": "error",
		"yoda": "error"
	},
	"overrides": [
		{
			"files": ["**/*.ts", "**/*.tsx", "**/*.mts", "**/*.cts"],
			"rules": {
				"no-class-assign": "off",
				"no-const-assign": "off",
				"no-dupe-class-members": "off",
				"no-dupe-keys": "off",
				"no-func-assign": "off",
				"no-import-assign": "off",
				"no-new-native-nonconstructor": "off",
				"no-obj-calls": "off",
				"no-redeclare": "off",
				"no-setter-return": "off",
				"no-this-before-super": "off",
				"no-unsafe-negation": "off",
				"no-var": "error",
				"no-with": "off",
				"prefer-rest-params": "error",
				"prefer-spread": "error"
			}
		},
		{
			"files": ["*.svelte", "**/*.svelte"],
			"rules": {
				"no-inner-declarations": "off",
				"no-self-assign": "off"
			}
		},
		{
			"files": ["*.test.ts", "*.spec.ts"],
			"rules": {
				"@typescript-eslint/unbound-method": "off",
				"require-mock-type-parameters": "off",
				"vitest/no-standalone-expect": ["error", { "additionalTestBlockFunctions": ["test"] }]
			}
		},
		{
			"files": ["src/lib/server/test/fixture.ts"],
			"rules": {
				"no-empty-pattern": "off",
				"vitest/expect-expect": "off",
				"vitest/no-disabled-tests": "off"
			}
		}
	],
	"settings": {
		"vitest": {
			"typecheck": true
		}
	}
}
