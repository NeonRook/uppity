// Type checks the one file that runs under Deno rather than Node.
//
// `types` names Deno and not Node, so `Deno.*` resolves here and nowhere else:
// an accidental `Deno.` in src/ still fails to compile, which keeps application
// code on the runtime the dev loop and the tests actually use.
//
// Runs after the build rather than with `check`, because the entry imports the
// adapter's generated output and those files are absent in a fresh checkout.
{
	"compilerOptions": {
		"strict": true,
		"noEmit": true,
		"target": "esnext",
		"module": "esnext",
		"moduleResolution": "bundler",
		"lib": ["esnext", "DOM"],
		"types": ["deno"],
		"resolveJsonModule": true,
		"forceConsistentCasingInFileNames": true
	},
	"include": ["./deno-serve.ts", "./adapter-handler.d.ts"]
}
